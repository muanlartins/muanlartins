# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# brand tooling
/brand/.venv
__pycache__/
/.next-en/

# The Twitch Pix panel holds the Pix key (brand/build.py, PIX_BRCODE).
brand/twitch/paineis/pix.*

# Models for the camera filters that must not be published (a game character extracted from the game).
public/stream/privado/

# video-agent-skills (Melvynx): the engine's packages and the working files; styles/ stays in git, but not
# the reference reels' frames (other creators' work)
.claude/skills/short-editing/engine/node_modules/
video-agent/.tmp/
video-agent/takes/
video-agent/edits/
video-agent/.env

video-agent/styles/*/stills/

# Other people's footage and art on Celeste's technique pages (games' clips, the cartoon): a local preview shows them,
# nothing here is committed or published until Luan decides on each.
public/celeste/terceiros/

# The Universo Valorant voice lines (scripts/valorant_falas.py): the release copies them to the bucket, never git.
public/valorant/falas/
