# Copy to live/.env (git ignores it) and fill in.

# The Pix key donations go to. A random key (chave aleatória) keeps your CPF,
# e-mail and phone out of the QR code.
PIX_KEY=
# Shown to the payer by their bank app. Plain ASCII, up to 25 and 15 characters.
PIX_NAME=muanlartins
PIX_CITY=

# The phone sends this with each notification. Generate one with: openssl rand -hex 24
PHONE_TOKEN=

# Smallest donation, in cents.
MIN_CENTS=1
